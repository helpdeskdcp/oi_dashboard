SYMBOL=NIFTY
REFRESH_INTERVAL=7
STRIKES_EACH_SIDE=4
PORT=5050
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET=replace-with-a-long-random-secret

ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PASSWORD=your_login_pin_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# Optional -- leave blank to disable Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Signal Engine / Paper Trading (virtual money only, no real orders)
SIGNAL_CONFIDENCE_THRESHOLD=60
TARGET_DELTA_APPROX=0.55
SL_PERCENT=0.35
MIN_TARGET_PERCENT=0.15
MAX_HOLD_MINUTES=30
PAPER_TRADE_LOT_QTY=1
PAPER_TRADING_ENABLED=true

# Fake-signal filter (reduces whipsaws)
MIN_OI_CHANGE_THRESHOLD=500
BIAS_PERSISTENCE_SECONDS=60
COOLDOWN_MINUTES_AFTER_SL=10
TIME_EXIT_COOLDOWN_THRESHOLD=2
COOLDOWN_MINUTES_AFTER_TIMEOUT=15

# Optional -- ChatGPT market commentary card. Leave OPENAI_API_KEY blank to disable
# entirely (dashboard works fully without it). Only calls the API for whichever
# symbol is currently being viewed, refreshed every COMMENTARY_REFRESH_SECONDS --
# not per cycle, to control cost/latency.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
COMMENTARY_REFRESH_SECONDS=120

# Historical logging for backtesting (SQLite, grows over time as app.py runs)
DB_PATH=oi_history.db

# Credit-saving: how often (seconds) to re-check if market has opened, while closed
CLOSED_SLEEP_SECONDS=300

# Dev mode: keep fetching (throttled) even when market is closed, using
# Friday's last-known data, so you can test the UI on weekends. No paper
# trades open and nothing gets logged to the backtest DB while this is on.
DEV_MODE_WHEN_CLOSED=false
DEV_MODE_REFRESH_SECONDS=60

# Optional -- save raw NSE JSON responses to this folder for audit/debugging
NSE_SNAPSHOT_DIR=

# Angel One session hygiene: proactive relogin every N seconds (default 6 hours),
# plus automatic reactive relogin if a call fails with a session/token-expiry error
ANGEL_SESSION_REFRESH_SECONDS=21600

# NOTE: as of the accounts/roles system below, DASHBOARD_USERNAME/PASSWORD are
# no longer read anywhere (the old single-shared HTTP Basic Auth was replaced
# by real per-user accounts + session login) -- left here harmlessly for
# anyone who still has them set.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-strong-password
DASHBOARD_HOST=127.0.0.1
SOCKETIO_ALLOWED_ORIGINS=
ALLOW_INSECURE_LOCAL=false

# ----------------------------------------------------------------------------
# Accounts / Roles / Subscriptions / Wallet (session-based login)
# ----------------------------------------------------------------------------

# One-time bootstrap admin -- init_db() creates this row ONLY if no admin-role
# user exists yet (safe to leave set permanently; no-ops once an admin exists).
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# SMTP for account-verification emails (STARTTLS). Leave SMTP_HOST blank to
# disable email sending -- verification links then only become available via
# the admin panel (/admin/users -> "Resend / Get Link"), which is the secure
# fallback: raw links are never shown on any public page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Subscription / trial / wallet business rules
TRIAL_DAYS=15
DEFAULT_WALLET_BALANCE=50000
WALLET_LOW_BALANCE_THRESHOLD=500
SUPPORT_PHONE_NUMBER=

# Session / login hardening
SESSION_COOKIE_SECURE=true      # set false ONLY if serving over plain HTTP (no TLS yet)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
